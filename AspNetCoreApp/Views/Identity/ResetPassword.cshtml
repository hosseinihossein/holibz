@model Identity_ResetPasswordFormModel

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA=="
    crossorigin="anonymous" referrerpolicy="no-referrer">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
    rel="stylesheet">

<style>
    * {
        box-sizing: border-box;
        outline: 0;
        font-family: "Montserrat", Helvetica, Arial, sans-serif;
        font-optical-sizing: auto;
        font-style: normal;
    }

    .clearfix::after {
        content: "";
        clear: both;
        display: table;
    }

    body {
        font-size: 100%;
        /*overflow-x: hidden;*/
    }
</style>

<style>
    #form7d70cebdf1e04b3185dd516ec2966d3e {
        width: 50%;
        margin: 70px auto 0;
        color: #333;
        box-shadow: 0 0 5px gray;
        border-radius: 5px;
    }

    /* Add padding to containers */
    #form7d70cebdf1e04b3185dd516ec2966d3e .container {
        padding: 8px 24px;
    }

    #form7d70cebdf1e04b3185dd516ec2966d3e label {
        font-size: 14px;
    }

    /* Full-width input fields */
    #form7d70cebdf1e04b3185dd516ec2966d3e input[type=text],
    #form7d70cebdf1e04b3185dd516ec2966d3e input[type=password] {
        width: 100%;
        padding: 10px 20px;
        margin: 5px 0 25px 0;
        display: inline-block;
        border: 2px solid gray;
        background: white;
        font-size: 14px;
        border-radius: 5px;
        color: #333;
    }

    #form7d70cebdf1e04b3185dd516ec2966d3e input[type=text]:focus,
    #form7d70cebdf1e04b3185dd516ec2966d3e input[type=password]:focus {
        border-color: #333;
        color: #111;
    }

    /* Overwrite default styles of hr */
    #form7d70cebdf1e04b3185dd516ec2966d3e hr {
        border: 1px solid #f1f1f1;
        margin-bottom: 25px;
    }

    /* Set a style for the submit/register button */
    #form7d70cebdf1e04b3185dd516ec2966d3e .registerbtn {
        background-color: white;
        color: #333;
        padding: 16px 20px;
        display: block;
        margin: 8px auto;
        border: 2px solid gray;
        cursor: pointer;
        width: 200px;
        /*opacity: 0.9;*/
        border-radius: 10px;
        font-size: 16px;
        transition: all 0.2s;
    }

    #form7d70cebdf1e04b3185dd516ec2966d3e .registerbtn:hover {
        /*opacity: 1;*/
        color: #111;
        /*border-color: gray;*/
        width: 300px;
        box-shadow: 0 0 5px gray;
        /*background-color: rgb(227, 255, 199);*/
    }

    #form7d70cebdf1e04b3185dd516ec2966d3e i {
        position: absolute;
        top: 35px;
        right: 15px;
        z-index: 1;
        cursor: pointer;
    }

    @@media screen and (max-width:800px) {
        #form7d70cebdf1e04b3185dd516ec2966d3e {
            width: 80%;
        }
    }

    @@media screen and (max-width:600px) {
        #form7d70cebdf1e04b3185dd516ec2966d3e {
            width: 100%;
        }

        #form7d70cebdf1e04b3185dd516ec2966d3e input[type=text],
        #form7d70cebdf1e04b3185dd516ec2966d3e input[type=password] {
            padding-left: 10px;
        }

        #form7d70cebdf1e04b3185dd516ec2966d3e i {
            right: 5px;
        }
    }
</style>

<div id="form7d70cebdf1e04b3185dd516ec2966d3e">
    <form asp-action="SubmitResetPassword" method="post">
        <div class="container">
            <h1>New Password</h1>
            <p>Please fill in the form with the verification code and a new password.</p>
            <hr>

            <div asp-validation-summary="All" style="color: red;"></div>

            <input asp-for="UserGuid" type="hidden">
            <input asp-for="Token" type="hidden">

            <div style="position: relative;">
                <label asp-for="NewPassword"><b>New Password</b></label>
                <input asp-for="NewPassword" type="password" placeholder="Enter New Password" id="NewPassword"
                    required="" minlength="8" maxlength="60">
                <i class="fa-regular fa-eye" onclick="showPassword_form7d70cebdf1e04b3185dd516ec2966d3e(this)"></i>
                <i class="fa-regular fa-eye-slash" style="display: none;"
                    onclick="hidePassword_form7d70cebdf1e04b3185dd516ec2966d3e(this)"></i>
            </div>

            <div style="position: relative;">
                <label asp-for="RepeatNewPassword"><b>Repeat New Password</b></label>
                <input asp-for="RepeatNewPassword" type="password" placeholder="Repeat New Password"
                    id="RepeatNewPassword" required="">
                <i class="fa-regular fa-eye" onclick="showPassword_form7d70cebdf1e04b3185dd516ec2966d3e(this)"></i>
                <i class="fa-regular fa-eye-slash" style="display: none;"
                    onclick="hidePassword_form7d70cebdf1e04b3185dd516ec2966d3e(this)"></i>
            </div>

            <hr>

            <button type="submit" class="registerbtn">Update Password</button>
        </div>
    </form>
    <script>
        function showPassword_form7d70cebdf1e04b3185dd516ec2966d3e(element) {
            element.parentElement.getElementsByTagName("input")[0].type = "text";
            element.style.display = "none";
            element.nextElementSibling.style.display = "block";
        }
        function hidePassword_form7d70cebdf1e04b3185dd516ec2966d3e(element) {
            element.parentElement.getElementsByTagName("input")[0].type = "password";
            element.style.display = "none";
            element.previousElementSibling.style.display = "block";
        }
    </script>
</div>